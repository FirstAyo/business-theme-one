# Public production origin (no trailing slash). Rebuild after editing.
VITE_SITE_URL=https://example.com
# Optional HTTP(S) API origin or same-origin path, for example /api.
# The form POSTs to {VITE_API_BASE_URL}/inquiries. No credentials here.
VITE_API_BASE_URL=
# Show honest sample-content indicators. Set false after replacing demo content.
VITE_DEMO_MODE=true
