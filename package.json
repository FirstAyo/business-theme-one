{
  "name": "business-theme-one",
  "private": true,
  "version": "1.0.0",
  "description": "Nexora: a premium, accessible business consulting template by Crafted Template",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "dev-host": "vite --host --configLoader runner",
    "build": "vite build --configLoader runner && vite build --configLoader runner --ssr src/entry-server.jsx --outDir .prerender && node scripts/prerender.mjs",
    "check": "npm run lint && npm run build && node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "lint": "eslint .",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
